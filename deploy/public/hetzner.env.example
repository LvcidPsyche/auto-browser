# Copy to a private host env file; do not commit populated values.
# Private identity data directory, owned by UID 10001 with mode 0700.
IDENTITY_HOST_STATE_ROOT=CHANGE_ME_PRIVATE_IDENTITY_STATE_DIRECTORY
# Private portal data directory, owned by UID 10001 with mode 0700.
PORTAL_HOST_STATE_ROOT=CHANGE_ME_PRIVATE_PORTAL_STATE_DIRECTORY
# Private gateway data directory, owned by UID 10001 with mode 0700.
MCP_GATEWAY_HOST_STATE_ROOT=CHANGE_ME_PRIVATE_GATEWAY_STATE_DIRECTORY
# Private provisioner descriptor root, owned by UID 10001 with mode 0700.
TENANT_STACK_HOST_ROOT=CHANGE_ME_PRIVATE_TENANT_STACK_DIRECTORY
# Existing private Docker network carrying tenant broker aliases.
TENANT_CONTROL_NETWORK=CHANGE_ME_EXISTING_TENANT_CONTROL_NETWORK
# Canonical public portal HTTPS origin.
PORTAL_PUBLIC_ORIGIN=CHANGE_ME_PORTAL_HTTPS_ORIGIN
# Canonical public OAuth issuer HTTPS origin.
MCP_GATEWAY_ISSUER_URL=CHANGE_ME_GATEWAY_HTTPS_ISSUER_ORIGIN
# Canonical public OAuth-protected MCP URL ending in /mcp.
MCP_GATEWAY_RESOURCE_URL=CHANGE_ME_GATEWAY_HTTPS_MCP_RESOURCE_URL
# Canonical public portal HTTPS origin used during OAuth authorization.
MCP_GATEWAY_PORTAL_URL=CHANGE_ME_PORTAL_HTTPS_ORIGIN
# Long random credential for identity administration only.
IDENTITY_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_IDENTITY_ADMIN_TOKEN
# Long random credential shared by identity and portal only.
IDENTITY_INTERNAL_TOKEN=CHANGE_ME_LONG_RANDOM_IDENTITY_INTERNAL_TOKEN
# Fernet-compatible key for encrypted identity secrets.
IDENTITY_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
# Long random pepper for identity recovery code derivation.
IDENTITY_RECOVERY_PEPPER=CHANGE_ME_LONG_RANDOM_RECOVERY_PEPPER
# Comma-separated private proxy CIDRs trusted by identity.
IDENTITY_TRUSTED_PROXY_CIDRS=CHANGE_ME_PRIVATE_PROXY_CIDRS
# Portal freshness period in seconds.
PORTAL_AUTHENTICATION_FRESHNESS_SECONDS=CHANGE_ME_FRESHNESS_SECONDS
# Base64url Ed25519 private key used for broker assertions.
PORTAL_ASSERTION_PRIVATE_KEY=CHANGE_ME_BASE64URL_ED25519_PRIVATE_KEY
# Base64url Ed25519 public key passed to the tenant provisioner.
BROKER_PORTAL_ASSERTION_PUBLIC_KEY=CHANGE_ME_BASE64URL_ED25519_PUBLIC_KEY
# Long random credential shared by portal and MCP gateway internals.
MCP_GATEWAY_INTERNAL_TOKEN=CHANGE_ME_LONG_RANDOM_GATEWAY_INTERNAL_TOKEN
# Long random credential shared only by the portal and private policy applier.
TENANT_POLICY_INTERNAL_TOKEN=CHANGE_ME_LONG_RANDOM_TENANT_POLICY_INTERNAL_TOKEN
