# Copy this file to .env on the host and replace every CHANGE_ME value.
# Never commit the populated .env file.
APP_ENV=production
API_BIND_SCOPE=exposed
API_PORT=18000
NOVNC_PORT=16080
VNC_PORT=15900
API_BEARER_TOKEN=CHANGE_ME_ROOT_TOKEN
OWNER_API_TOKEN=CHANGE_ME_OWNER_TOKEN
BROKER_OWNER_TOKEN=CHANGE_ME_BROKER_OWNER_TOKEN
BROKER_AGENT_TOKENS=assistant_one:CHANGE_ME_AGENT_ONE_TOKEN,assistant_two:CHANGE_ME_AGENT_TWO_TOKEN,assistant_three:CHANGE_ME_AGENT_THREE_TOKEN
BROKER_PORT=18001
BROKER_STATE_ROOT=/srv/auto-browser-broker
SHARE_TOKEN_SECRET=CHANGE_ME_SHARE_SECRET
AUTH_STATE_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
REQUIRE_AUTH_STATE_ENCRYPTION=true
REQUIRE_OPERATOR_ID=true
REQUEST_RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true
CONTROLLER_ALLOWED_HOSTS=localhost,127.0.0.1,::1,controller
ALLOWED_HOSTS=google.com,facebook.com,instagram.com,meta.com,example.com
MAX_SESSIONS=1
STEALTH_ENABLED=false
MCP_ALLOWED_ORIGINS=http://localhost:18000,http://127.0.0.1:18000
TAKEOVER_URL=http://127.0.0.1:16080/vnc.html?autoconnect=true&resize=scale
